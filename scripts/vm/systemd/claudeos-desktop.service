[Unit]
Description=claudeOS browser desktop (TigerVNC :1 + openbox + Chrome, localhost only)

[Service]
ExecStart=/usr/bin/tigervncserver :1 -fg -localhost yes -geometry 1600x1000 -depth 24 -rfbauth %h/.config/tigervnc/passwd -xstartup %h/.config/tigervnc/xstartup
ExecStop=/usr/bin/tigervncserver -kill :1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
