# Copy to .env (never committed). Only the twin on the server needs this.

# Discord: a bot in your own server, one private channel for briefs and drafts.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=          # your Discord user id; only your messages count as replies

# Optional: the assistant's own mailbox (IMAP 993 + SMTP 587 on the same host). Leave MAIL_SERVER empty to skip mail.
MAIL_SERVER=
MAIL_LOGIN=
MAIL_PASS=
MAIL_FROM="Jarvis <jarvis@example.com>"
OWNER_EMAIL=               # always in Cc on mail the assistant sends; mail from it wakes the twin

# Optional: graphify uses an LLM key for non-code files (see graphify docs), e.g.
# GEMINI_API_KEY=
